{
  "name": "stack-visualizer",
  "displayName": "Pile ou Face",
  "description": "Binary reverse engineering tool for CTF: disassembly, CFG, call graph, xrefs, decompilation and annotations for ELF/PE/Mach-O binaries.",
  "version": "0.2.0",
  "publisher": "PileOuFaces",
  "type": "commonjs",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/PileOuFaces/Pile_Ou_Face"
  },
  "keywords": [
    "reverse engineering",
    "disassembly",
    "binary analysis",
    "CTF",
    "ELF",
    "PE",
    "decompiler",
    "CFG",
    "assembly"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "icon": "media/icon-light.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "homepage": "https://github.com/PileOuFaces/Pile_Ou_Face",
  "bugs": {
    "url": "https://github.com/PileOuFaces/Pile_Ou_Face/issues"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:asm"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pileOuFace.open",
        "title": "Pile ou Face",
        "icon": {
          "light": "media/icon-light.png",
          "dark": "media/icon-dark.png"
        }
      },
      {
        "command": "pileOuFace.sidebarRefresh",
        "title": "%command.loadBinary%"
      },
      {
        "command": "pileOuFace.calculator",
        "title": "%command.calculator%"
      },
      {
        "command": "pileOuFace.xrefsTo",
        "title": "%command.xrefsTo%"
      },
      {
        "command": "pileOuFace.xrefsFrom",
        "title": "%command.xrefsFrom%"
      },
      {
        "command": "pileOuFace.askAiAboutDisasm",
        "title": "%command.askAiAboutDisasm%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.autoTriage",
        "title": "%command.autoTriage%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.importFromGhidra",
        "title": "%command.importFromGhidra%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.importFromIda",
        "title": "%command.importFromIda%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.goToSymbolInDisasm",
        "title": "%command.goToSymbol%"
      },
      {
        "command": "pileOuFace.exportDisasm",
        "title": "%command.exportDisasm%"
      },
      {
        "command": "pileOuFace.disasmSection",
        "title": "%command.disasmSection%"
      },
      {
        "command": "pileOuFace.goToAddress",
        "title": "%command.goToAddress%"
      },
      {
        "command": "pileOuFace.decompilerAdd",
        "title": "%command.decompilerAdd%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.decompilerEdit",
        "title": "%command.decompilerEdit%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.decompilerRemove",
        "title": "%command.decompilerRemove%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.decompilerList",
        "title": "%command.decompilerList%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.decompilerTest",
        "title": "%command.decompilerTest%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.decompilerOpenConfig",
        "title": "%command.decompilerOpenConfig%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.showLogs",
        "title": "%command.showLogs%",
        "category": "Pile ou Face"
      },
      {
        "command": "pileOuFace.perfSnapshot",
        "title": "%command.perfSnapshot%",
        "category": "Pile ou Face"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pileOuFace.open",
          "group": "navigation",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "pileOuFace.askAiAboutDisasm",
          "group": "pileOuFace@1",
          "when": "resourceExtname == .asm"
        },
        {
          "command": "pileOuFace.xrefsTo",
          "group": "pileOuFace@2",
          "when": "resourceExtname == .asm"
        },
        {
          "command": "pileOuFace.xrefsFrom",
          "group": "pileOuFace@3",
          "when": "resourceExtname == .asm"
        },
        {
          "command": "pileOuFace.exportDisasm",
          "group": "pileOuFace@4",
          "when": "resourceExtname == .asm"
        }
      ],
      "commandPalette": [
        {
          "command": "pileOuFace.open",
          "when": "true"
        },
        {
          "command": "pileOuFace.sidebarRefresh",
          "when": "true"
        },
        {
          "command": "pileOuFace.calculator",
          "when": "true"
        },
        {
          "command": "pileOuFace.exportDisasm",
          "when": "editorTextFocus"
        },
        {
          "command": "pileOuFace.importFromGhidra",
          "when": "true"
        },
        {
          "command": "pileOuFace.importFromIda",
          "when": "true"
        },
        {
          "command": "pileOuFace.xrefsTo",
          "when": "resourceExtname == .asm"
        },
        {
          "command": "pileOuFace.xrefsFrom",
          "when": "resourceExtname == .asm"
        },
        {
          "command": "pileOuFace.decompilerAdd",
          "when": "true"
        },
        {
          "command": "pileOuFace.decompilerEdit",
          "when": "true"
        },
        {
          "command": "pileOuFace.decompilerRemove",
          "when": "true"
        },
        {
          "command": "pileOuFace.decompilerList",
          "when": "true"
        },
        {
          "command": "pileOuFace.showLogs",
          "when": "true"
        },
        {
          "command": "pileOuFace.perfSnapshot",
          "when": "config.pileOuFace.perfDiagnostics == true"
        },
        {
          "command": "pileOuFace.decompilerTest",
          "when": "true"
        },
        {
          "command": "pileOuFace.decompilerOpenConfig",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pileOuFace.open",
        "key": "alt+shift+p",
        "mac": "alt+shift+p"
      },
      {
        "command": "pileOuFace.calculator",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "pileOuFace.goToAddress",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "languages": [
      {
        "id": "asm",
        "aliases": [
          "Assembly",
          "asm"
        ],
        "extensions": [
          ".asm"
        ],
        "configuration": "./syntaxes/asm-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asm",
        "scopeName": "source.asm",
        "path": "./syntaxes/asm.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pile ou Face",
      "properties": {
        "pileOuFace.authServerUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authServerUrl%"
        },
        "pileOuFace.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "%config.logLevel%"
        },
        "pileOuFace.keymap": {
          "type": "string",
          "enum": [
            "default",
            "ida"
          ],
          "enumDescriptions": [
            "%config.keymap.default%",
            "%config.keymap.ida%"
          ],
          "default": "default",
          "description": "%config.keymap%"
        },
        "pileOuFace.perfDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "%config.perfDiagnostics%"
        },
        "pileOuFace.autoTriage.enabled": {
          "type": "boolean",
          "default": false,
          "tags": [
            "usesOnlineServices"
          ],
          "description": "%config.autoTriage.enabled%"
        },
        "pileOuFace.autoTriage.model": {
          "type": "string",
          "default": "",
          "description": "%config.autoTriage.model%"
        },
        "pileOuFace.autoTriage.maxFunctions": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "description": "%config.autoTriage.maxFunctions%"
        },
        "pileOuFace.autoTriage.maxSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 30,
          "maximum": 7200,
          "description": "%config.autoTriage.maxSeconds%"
        },
        "pileOuFace.autoTriage.maxTokensPerRequest": {
          "type": "integer",
          "default": 2048,
          "minimum": 128,
          "maximum": 32768,
          "description": "%config.autoTriage.maxTokensPerRequest%"
        },
        "pileOuFace.autoTriage.maxTotalTokens": {
          "type": "integer",
          "default": 100000,
          "minimum": 1024,
          "maximum": 1000000,
          "description": "%config.autoTriage.maxTotalTokens%"
        },
        "pileOuFace.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "description": "%config.telemetry.enabled%"
        },
        "pileOuFace.runtimeUsageAudit": {
          "type": "boolean",
          "default": false,
          "description": "%config.runtimeUsageAudit%"
        }
      }
    }
  },
  "scripts": {
    "configure:official": "node scripts/write-product-config.mjs",
    "vscode:prepublish": "npm run package",
    "build": "npm run typecheck && node esbuild.js",
    "build:watch": "node esbuild.js --watch",
    "package": "npm run typecheck && node esbuild.js --production",
    "profile:check:official": "node scripts/prepare-deployment-profile.js OFFICIAL_SAAS --check",
    "profile:prepare:official": "node scripts/prepare-deployment-profile.js OFFICIAL_SAAS",
    "profile:verify": "node scripts/verify-deployment-profile.js",
    "test:bundle": "npm run package && tsx scripts/smoke-bundle.ts",
    "test:e2e:audit": "node scripts/e2e/run-runtime-audit.js",
    "test:e2e:audit:coverage": "node scripts/e2e/runtime-audit-feature-coverage.js",
    "test:e2e:audit:workflow": "node scripts/e2e/runtime-audit-workflow-report.js",
    "test:e2e:auth-licensing": "tsx scripts/e2e/authLicensingInteropE2E.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run lint:i18n",
    "lint:fix": "eslint . --fix",
    "lint:i18n": "node scripts/check-i18n-coverage.js",
    "test": "tsx node_modules/.bin/_mocha '{front/tests,src/tests}/**/*.test.ts' --ignore 'front/tests/hubPayloadCore.test.ts' --require src/tests/setup.ts --exit",
    "test:watch": "tsx node_modules/.bin/_mocha '{front/tests,src/tests}/**/*.test.ts' --watch --ignore 'front/tests/hubPayloadCore.test.ts' --require src/tests/setup.ts",
    "test:coverage": "c8 tsx node_modules/.bin/_mocha '{front/tests,src/tests}/**/*.test.ts' --ignore 'front/tests/hubPayloadCore.test.ts' --require src/tests/setup.ts --exit",
    "test:auto-triage:coverage": "c8 --all --include front/static/autoTriageController.js --reporter=text --check-coverage --lines 80 --statements 80 --functions 80 --branches 80 tsx node_modules/.bin/_mocha front/tests/autoTriageController.behavior.test.ts --require src/tests/setup.ts --exit && tsx node_modules/.bin/_mocha src/tests/staticHandlersAutoTriage.test.ts --require src/tests/setup.ts --exit && backends/.venv/bin/python scripts/auto-triage-python-coverage.py",
    "test:decompile-augmentation:coverage": "c8 --all --include front/static/decompileAugmentationController.js --reporter=text --check-coverage --lines 80 --statements 80 --functions 80 --branches 80 tsx node_modules/.bin/_mocha front/tests/decompileAugmentationController.behavior.test.ts --require src/tests/setup.ts --exit && backends/.venv/bin/python -m coverage run --branch --source=backends.static.decompile.augment -m pytest backends/static/decompile/tests/test_augment.py && backends/.venv/bin/python -m coverage report --include=backends/static/decompile/augment.py --fail-under=80 --show-missing",
    "coverage:summary": "node scripts/coverage-summary.mjs --python coverage-python.json --javascript coverage/coverage-summary.json --output .pile-ou-face/test-artifacts/coverage-summary.md",
    "nexus:analyze": "npx gitnexus analyze ..",
    "nexus:status": "npx gitnexus status",
    "nexus:wiki": "npx gitnexus wiki .."
  },
  "ts-node": {
    "transpileOnly": true,
    "esm": false
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.2",
    "c8": "^10.1.3",
    "chai": "^4.3.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "mocha": "^10.2.0",
    "prettier": "^3.8.1",
    "proxyquire": "^2.1.3",
    "sinon": "^17.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
