{
  "mcpServers": {
    "pile-ou-face": {
      "type": "stdio",
      "command": "/opt/homebrew/opt/python@3.14/bin/python3.14",
      "args": [
        "/Users/leoteissier/Projets/Pile_Ou_Face/Pile_Ou_Face/extension/backends/mcp/server.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "POF_MCP_WORKSPACE_ROOT": "/Users/leoteissier/Projets/Pile_Ou_Face/Pile_Ou_Face"
      }
    },
    "gitnexus": {
      "command": "npx",
      "args": [
        "gitnexus",
        "mcp"
      ],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--output-dir",
        "../.playwright-mcp",
        "--output-mode",
        "file"
      ],
      "env": {}
    }
  }
}
